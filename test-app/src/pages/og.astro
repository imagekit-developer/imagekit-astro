---
import { getOgImageTags } from '@imagekit/astro/helpers';

const tags = getOgImageTags({
  src: '/default-image.jpg',
  title: 'Hello from @imagekit/astro',
  description: 'A demo of getOgImageTags() — single image URL used for both OG and Twitter, format auto-selected by ImageKit.',
  alt: 'Default ImageKit demo image',
});

const minimal = getOgImageTags({
  src: '/default-image.jpg',
  ogTitle: 'OG only title',
});

const customSize = getOgImageTags({
  src: '/default-image.jpg',
  title: 'Custom dimensions',
  width: 800,
  height: 418,
  transformation: [{ blur: 3 }],
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OG Image Tags Test</title>
  {tags.map((tag) => <meta property={tag.property} content={tag.content} />)}
  <style>
    body {
      font-family: system-ui, sans-serif;
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 20px;
    }
    h2 {
      margin-top: 40px;
      color: #555;
    }
    pre {
      background: #f6f8fa;
      border: 1px solid #ddd;
      border-radius: 6px;
      padding: 12px;
      overflow-x: auto;
      font-size: 13px;
    }
    .note {
      color: #666;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <h1>getOgImageTags() Output</h1>
  <p class="note">View source to see the generated &lt;meta&gt; tags injected into the page &lt;head&gt;.</p>

  <h2>Default (full options)</h2>
  <pre>{JSON.stringify(tags, null, 2)}</pre>

  <h2>Minimal (ogTitle only)</h2>
  <pre>{JSON.stringify(minimal, null, 2)}</pre>

  <h2>Custom dimensions + extra transformation (blur)</h2>
  <pre>{JSON.stringify(customSize, null, 2)}</pre>
</body>
</html>
