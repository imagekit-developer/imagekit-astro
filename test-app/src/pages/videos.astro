---
import { Video } from '@imagekit/astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Video Tests</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      padding: 20px;
    }
    h1, h2 {
      color: #333;
    }
    .example {
      margin-bottom: 30px;
      padding: 15px;
      border: 1px solid #ddd;
      border-radius: 8px;
    }
    .example h3 {
      margin-top: 0;
      color: #555;
    }
    video {
      display: block;
      max-width: 100%;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Video Component Tests</h1>

    <!-- Basic video with urlEndpoint prop -->
    <div class="example">
      <h3>Basic Video with urlEndpoint prop</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="Video with urlEndpoint prop"
        height={300}
        width={300}
        controls
      />
    </div>

    <!-- Video with leading slash in src -->
    <div class="example">
      <h3>Video with leading slash in src</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/sample-video.mp4"
        title="Video with leading slash"
        height={300}
        width={300}
        controls
      />
    </div>

    <!-- Video with transformations -->
    <div class="example">
      <h3>Video with transformations</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="Video with transformations"
        transformation={[{ height: 100, width: 100 }]}
        height={300}
        width={300}
        controls
      />
    </div>

    <!-- Video with all props -->
    <div class="example">
      <h3>Video with all HTML attributes</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="Video with all props"
        height={300}
        width={300}
        controls
        autoplay
        loop
        muted
        preload="none"
        poster="https://ik.imagekit.io/demo/default-image.jpg"
      />
    </div>

    <!-- urlEndpoint override -->
    <div class="example">
      <h3>Video with different urlEndpoint</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo2/"
        src="sample-video.mp4"
        title="Video with urlEndpoint override"
        height={300}
        width={300}
        transformation={[{ height: 100, width: 100 }]}
        controls
      />
    </div>

    <!-- transformationPosition="path" -->
    <div class="example">
      <h3>Video with transformationPosition="path"</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="Video with path transformation"
        transformationPosition="path"
        height={300}
        width={300}
        transformation={[{ height: 100, width: 100 }]}
        controls
      />
    </div>

    <!-- Video with custom class -->
    <div class="example">
      <h3>Video with custom class</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="Video with custom class"
        class="custom-video-class"
        height={300}
        width={300}
        controls
      />
    </div>

    <!-- Video with queryParameters -->
    <div class="example">
      <h3>Video with queryParameters</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="Video with queryParameters"
        queryParameters={{
          version: "v2",
        }}
        height={300}
        width={300}
        controls
      />
    </div>

    <!-- Video with chained transformations -->
    <div class="example">
      <h3>Video with chained transformations</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="Video with chained transformations"
        transformation={[
          { width: 200, height: 200 },
          { quality: 80 },
        ]}
        height={300}
        width={300}
        controls
      />
    </div>

    <!-- Video without controls (for autoplay scenarios) -->
    <div class="example">
      <h3>Video without controls (autoplay, muted, loop)</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="Autoplay video"
        height={200}
        width={300}
        autoplay
        muted
        loop
      />
    </div>

    <!-- EDGE CASE TESTS -->
    <h2>Edge Case Tests</h2>
    <p>Testing extreme values and boundary conditions for video component.</p>

    <!-- Minimal dimensions 1px x 1px -->
    <div class="example" data-test-id="video-edge-minimal">
      <h3>Minimal dimensions (1px × 1px)</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="minimal video 1x1"
        width={1}
        height={1}
        controls
      />
    </div>

    <!-- Large dimensions -->
    <div class="example" data-test-id="video-edge-large">
      <h3>Large dimensions (4000px × 2000px)</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="large video"
        width={4000}
        height={2000}
        controls
      />
    </div>

    <!-- Extreme aspect ratio tall -->
    <div class="example" data-test-id="video-edge-ratio-tall">
      <h3>Extreme aspect ratio (1:500)</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="tall aspect ratio"
        width={10}
        height={5000}
        controls
      />
    </div>

    <!-- Extreme aspect ratio wide -->
    <div class="example" data-test-id="video-edge-ratio-wide">
      <h3>Extreme aspect ratio (500:1)</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="wide aspect ratio"
        width={5000}
        height={10}
        controls
      />
    </div>

    <!-- Multiple complex transformations -->
    <div class="example" data-test-id="video-edge-complex-transformations">
      <h3>Multiple complex transformations</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="complex transformations"
        transformation={[
          { width: 200, height: 200 },
          { rotation: 90 },
          { quality: 50 },
          { aspectRatio: "16-9" }
        ]}
        width={300}
        height={300}
        controls
      />
    </div>

    <!-- transformationPosition="path" with transformations -->
    <div class="example" data-test-id="video-edge-transform-path">
      <h3>transformationPosition="path"</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="path transformation position"
        transformationPosition="path"
        transformation={[{ width: 200, height: 200 }]}
        width={300}
        height={300}
        controls
      />
    </div>

    <!-- transformationPosition="query" with queryParameters -->
    <div class="example" data-test-id="video-edge-transform-query">
      <h3>transformationPosition="query" + queryParameters</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="query transformation position"
        transformationPosition="query"
        queryParameters={{
          version: "v2",
          custom: "value"
        }}
        width={300}
        height={300}
        controls
      />
    </div>

    <!-- All HTML video attributes together -->
    <div class="example" data-test-id="video-edge-all-attributes">
      <h3>All HTML attributes combined</h3>
      <Video
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="sample-video.mp4"
        title="all attributes"
        width={300}
        height={300}
        controls
        autoplay
        loop
        muted
        preload="metadata"
        crossorigin="anonymous"
        data-test="custom-attribute"
      />
    </div>

  </div>
</body>
</html>
