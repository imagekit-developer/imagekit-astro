---
import { Image } from '@imagekit/astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Image Tests</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      padding: 20px;
    }
    h1, h2 {
      color: #333;
    }
    .example {
      margin-bottom: 30px;
      padding: 15px;
      border: 1px solid #ddd;
      border-radius: 8px;
    }
    .example h3 {
      margin-top: 0;
      color: #555;
    }
    img {
      display: block;
      max-width: 100%;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Image Component Tests</h1>
    <p>Image uses Astro's built-in Image component for optimized image delivery with ImageKit transformations.</p>

    <!-- Basic image with urlEndpoint prop -->
    <div class="example">
      <h3>1. Basic Image with urlEndpoint prop</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="default-image.jpg"
        alt="Image with urlEndpoint prop"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with leading slash in src -->
    <div class="example">
      <h3>2. Image with leading slash in src</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with leading slash"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with transformation -->
    <div class="example">
      <h3>3. Image with transformation</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="With transformation"
        transformation={[{ height: 100, width: 100 }]}
        width={300}
        height={300}
      />
    </div>

    <!-- Image with queryParameters -->
    <div class="example">
      <h3>4. Image with queryParameters</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with queryParameters"
        queryParameters={{
          version: "v1",
        }}
        transformation={[{ height: 100, width: 100 }]}
        width={300}
        height={300}
      />
    </div>

    <!-- Responsive image with sizes -->
    <div class="example">
      <h3>5. Responsive image with sizes</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Responsive image with sizes"
        sizes="(max-width: 600px) 100vw, 50vw"
        width={300}
        height={300}
      />
    </div>

    <!-- Responsive image with fixed sizes -->
    <div class="example">
      <h3>6. Responsive image with fixed sizes (300px)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Responsive image with fixed sizes"
        sizes="300px"
        width={300}
        height={300}
      />
    </div>

    <!-- Non-responsive image -->
    <div class="example">
      <h3>7. Non-responsive image (responsive=false)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Non-responsive image"
        responsive={false}
        width={300}
        height={300}
      />
    </div>

    <!-- Image with custom class -->
    <div class="example">
      <h3>8. Image with custom class</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with custom class"
        class="custom-class"
        width={300}
        height={300}
      />
    </div>

    <!-- Lazy loading eager -->
    <div class="example">
      <h3>9. Image with loading="eager"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with loading eager"
        loading="eager"
        width={300}
        height={300}
      />
    </div>

    <!-- Transformation position path -->
    <div class="example">
      <h3>10. Image with transformationPosition="path"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with path transformation"
        transformationPosition="path"
        width={300}
        height={300}
      />
    </div>

    <!-- Transformation position path with custom transformations -->
    <div class="example">
      <h3>11. Image with transformationPosition="path" + custom transformations</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with path transformation + custom transformations"
        transformationPosition="path"
        transformation={[{ height: 100, width: 100 }]}
        width={300}
        height={300}
      />
    </div>

    <!-- Custom device breakpoints -->
    <div class="example">
      <h3>12. Image with custom deviceBreakpoints</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with custom device breakpoints"
        deviceBreakpoints={[320, 640, 1024]}
        width={300}
        height={300}
      />
    </div>

    <!-- Custom image breakpoints -->
    <div class="example">
      <h3>13. Image with custom imageBreakpoints</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with custom image breakpoints"
        imageBreakpoints={[200, 400, 600]}
        width={300}
        height={300}
      />
    </div>

    <!-- Image with data attributes -->
    <div class="example">
      <h3>14. Image with data attributes</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with data attributes"
        data-testid="test-image"
        data-custom="value"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with multiple transformations -->
    <div class="example">
      <h3>15. Image with multiple chained transformations</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with multiple chained transformations"
        transformation={[
          { width: 200, height: 200 },
          { rotation: 90 },
          { blur: 5 }
        ]}
        width={300}
        height={300}
      />
    </div>

    <!-- ASTRO IMAGE COMPONENT SPECIFIC PROPS -->
    <h2>Astro Image Component Props</h2>
    <p>The following tests verify that Astro's built-in Image component props work correctly with Image.</p>

    <!-- Image with format prop -->
    <div class="example">
      <h3>16. Image with format="avif"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with AVIF format"
        format="avif"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with quality prop (preset) -->
    <div class="example">
      <h3>17. Image with quality="high"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with high quality preset"
        quality="high"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with quality prop (number) -->
    <div class="example">
      <h3>18. Image with quality=50</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with numeric quality"
        quality={50}
        width={300}
        height={300}
      />
    </div>

    <!-- Image with decoding prop -->
    <div class="example">
      <h3>19. Image with decoding="sync"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with sync decoding"
        decoding="sync"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with fetchpriority prop -->
    <div class="example">
      <h3>20. Image with fetchpriority="high"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with high fetch priority"
        fetchpriority="high"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with densities prop -->
    <div class="example">
      <h3>21. Image with densities=[1.5, 2]</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with density srcset"
        densities={[1.5, 2]}
        width={300}
        height={300}
      />
    </div>

    <!-- Image with widths prop -->
    <div class="example">
      <h3>22. Image with widths=[240, 540, 720]</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with specific widths srcset"
        widths={[240, 540, 720]}
        sizes="(max-width: 360px) 240px, (max-width: 720px) 540px, 720px"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with layout="constrained" -->
    <div class="example">
      <h3>23. Image with layout="constrained"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with constrained layout"
        layout="constrained"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with layout="full-width" -->
    <div class="example">
      <h3>24. Image with layout="full-width"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with full-width layout"
        layout="full-width"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with layout="fixed" -->
    <div class="example">
      <h3>25. Image with layout="fixed"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with fixed layout"
        layout="fixed"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with fit prop -->
    <div class="example">
      <h3>26. Image with fit="contain"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with contain fit"
        layout="constrained"
        fit="contain"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with position prop -->
    <div class="example">
      <h3>27. Image with position="top left"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with top left position"
        layout="constrained"
        position="top left"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with priority prop -->
    <div class="example">
      <h3>28. Image with priority (eager loading shorthand)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with priority flag"
        priority
        width={300}
        height={300}
      />
    </div>

    <!-- Image with style attribute -->
    <div class="example">
      <h3>29. Image with inline style</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with inline style"
        style="border: 3px solid red; border-radius: 10px;"
        width={300}
        height={300}
      />
    </div>

    <!-- Image with id attribute -->
    <div class="example">
      <h3>30. Image with id attribute</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Image with id"
        id="my-image-id"
        width={300}
        height={300}
      />
    </div>

    <!-- PROPERTY CONFLICT TESTS -->
    <h2>Property Conflict Tests (Invalid Combinations)</h2>
    <p>Per Astro docs: These property combinations should not be used together. Testing graceful handling.</p>

    <!-- densities + layout conflict -->
    <div class="example" data-test-id="conflict-densities-layout">
      <h3>31. CONFLICT: densities + layout (densities should be ignored)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Conflict: densities + layout"
        densities={[1.5, 2]}
        layout="constrained"
        width={300}
        height={300}
      />
    </div>

    <!-- densities + widths conflict -->
    <div class="example" data-test-id="conflict-densities-widths">
      <h3>32. CONFLICT: densities + widths (only one should be used)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Conflict: densities + widths"
        densities={[1.5, 2]}
        widths={[240, 540, 720]}
        sizes="(max-width: 360px) 240px, (max-width: 720px) 540px, 720px"
        width={300}
        height={300}
      />
    </div>

    <!-- widths without sizes -->
    <div class="example" data-test-id="conflict-widths-no-sizes">
      <h3>33. CONFLICT: widths without sizes (sizes required)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Conflict: widths without sizes"
        widths={[240, 540, 720]}
        width={300}
        height={300}
      />
    </div>

    <!-- layout=fixed + widths -->
    <div class="example" data-test-id="conflict-fixed-widths">
      <h3>34. CONFLICT: layout=fixed + widths (fixed layout shouldn't vary widths)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Conflict: layout=fixed + widths"
        layout="fixed"
        widths={[240, 540, 720]}
        sizes="(max-width: 360px) 240px, (max-width: 720px) 540px, 720px"
        width={300}
        height={300}
      />
    </div>

    <!-- layout=none + responsive prop -->
    <div class="example" data-test-id="conflict-none-layout-responsive">
      <h3>35. CONFLICT: layout=none + responsive=true (none disables responsiveness)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Conflict: layout=none + responsive"
        layout="none"
        responsive={true}
        width={300}
        height={300}
      />
    </div>

    <!-- VALID PROPERTY COMBINATIONS -->
    <h2>Valid Property Combinations</h2>
    <p>These property combinations work correctly together.</p>

    <!-- widths + sizes valid -->
    <div class="example" data-test-id="valid-widths-sizes">
      <h3>36. VALID: widths + sizes (responsive with explicit widths)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Valid: widths + sizes"
        widths={[240, 540, 720]}
        sizes="(max-width: 360px) 240px, (max-width: 720px) 540px, 720px"
        width={300}
        height={300}
      />
    </div>

    <!-- densities alone valid -->
    <div class="example" data-test-id="valid-densities-alone">
      <h3>37. VALID: densities alone (density-based srcset)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Valid: densities alone"
        densities={[1.5, 2]}
        width={300}
        height={300}
      />
    </div>

    <!-- layout=constrained + format + quality valid -->
    <div class="example" data-test-id="valid-layout-format-quality">
      <h3>38. VALID: layout=constrained + format + quality</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Valid: layout + format + quality"
        layout="constrained"
        format="webp"
        quality="high"
        width={300}
        height={300}
      />
    </div>

    <!-- layout=full-width with responsive -->
    <div class="example" data-test-id="valid-fullwidth-responsive">
      <h3>39. VALID: layout=full-width with responsive props</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Valid: layout full-width"
        layout="full-width"
        responsive={true}
        width={300}
        height={300}
      />
    </div>

    <!-- responsive + ImageKit breakpoints -->
    <div class="example" data-test-id="valid-responsive-breakpoints">
      <h3>40. VALID: responsive=true + ImageKit breakpoints</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="Valid: responsive + breakpoints"
        responsive={true}
        deviceBreakpoints={[320, 640, 1024]}
        imageBreakpoints={[200, 400, 600]}
        width={300}
        height={300}
      />
    </div>

    <!-- EDGE CASE TESTS -->
    <h2>Edge Case Tests</h2>
    <p>Testing extreme values and boundary conditions.</p>

    <!-- Minimal dimensions 1px x 1px -->
    <div class="example" data-test-id="edge-minimal-dimensions">
      <h3>41. Minimal dimensions (1px × 1px)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="minimal 1x1"
        width={1}
        height={1}
      />
    </div>

    <!-- Extreme aspect ratio 1:1000 -->
    <div class="example" data-test-id="edge-extreme-ratio-tall">
      <h3>42. Extreme aspect ratio (1:1000)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="1:1000 aspect ratio"
        width={10}
        height={10000}
      />
    </div>

    <!-- Extreme aspect ratio 1000:1 -->
    <div class="example" data-test-id="edge-extreme-ratio-wide">
      <h3>43. Extreme aspect ratio (1000:1)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="1000:1 aspect ratio"
        width={10000}
        height={10}
      />
    </div>

    <!-- Quality boundary: 0 -->
    <div class="example" data-test-id="edge-quality-0">
      <h3>44. Quality = 0 (minimum)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="quality 0"
        quality={0}
        width={300}
        height={300}
      />
    </div>

    <!-- Quality boundary: 100 -->
    <div class="example" data-test-id="edge-quality-100">
      <h3>45. Quality = 100 (maximum)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="quality 100"
        quality={100}
        width={300}
        height={300}
      />
    </div>

    <!-- Format: webp -->
    <div class="example" data-test-id="edge-format-webp">
      <h3>46. Format = webp</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="webp format"
        format="webp"
        width={300}
        height={300}
      />
    </div>

    <!-- Format: avif -->
    <div class="example" data-test-id="edge-format-avif">
      <h3>47. Format = avif</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="avif format"
        format="avif"
        width={300}
        height={300}
      />
    </div>

    <!-- Format: svg -->
    <div class="example" data-test-id="edge-format-svg">
      <h3>48. Format = svg</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="svg format"
        format="svg"
        width={300}
        height={300}
      />
    </div>

    <!-- Multiple complex transformations -->
    <div class="example" data-test-id="edge-complex-transformations">
      <h3>49. Multiple complex transformations</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="complex transformations"
        transformation={[
          { width: 200, height: 200 },
          { rotation: 45 },
          { blur: 10 },
          { quality: 50 },
          { overlayText: "WATERMARK" }
        ]}
        width={300}
        height={300}
      />
    </div>

    <!-- transformationPosition path with transformations -->
    <div class="example" data-test-id="edge-transform-position-path">
      <h3>50. transformationPosition="path" + transformations</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="transformation path position"
        transformationPosition="path"
        transformation={[{ width: 200, height: 200 }, { quality: 75 }]}
        width={300}
        height={300}
      />
    </div>

    <!-- transformationPosition query with complex query params -->
    <div class="example" data-test-id="edge-transform-position-query">
      <h3>51. transformationPosition="query" + queryParameters</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="transformation query position"
        transformationPosition="query"
        transformation={[{ width: 200, height: 200 }]}
        queryParameters={{
          version: "v1",
          custom: "param"
        }}
        width={300}
        height={300}
      />
    </div>

    <!-- Large width boundary test -->
    <div class="example" data-test-id="edge-large-width">
      <h3>52. Large width (5000px)</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="5000px width"
        width={5000}
        height={5000}
      />
    </div>

    <!-- Quality as string preset -->
    <div class="example" data-test-id="edge-quality-preset-low">
      <h3>53. Quality preset = "low"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="quality low preset"
        quality="low"
        width={300}
        height={300}
      />
    </div>

    <!-- Quality as string preset mid -->
    <div class="example" data-test-id="edge-quality-preset-mid">
      <h3>54. Quality preset = "mid"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="quality mid preset"
        quality="mid"
        width={300}
        height={300}
      />
    </div>

    <!-- Quality as string preset max -->
    <div class="example" data-test-id="edge-quality-preset-max">
      <h3>55. Quality preset = "max"</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="quality max preset"
        quality="max"
        width={300}
        height={300}
      />
    </div>

    <!-- Responsive with custom device breakpoints edge case -->
    <div class="example" data-test-id="edge-device-breakpoints">
      <h3>56. Responsive with extreme device breakpoints</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="device breakpoints"
        responsive={true}
        deviceBreakpoints={[100, 5000]}
        width={300}
        height={300}
      />
    </div>

    <!-- Responsive with custom image breakpoints edge case -->
    <div class="example" data-test-id="edge-image-breakpoints">
      <h3>57. Responsive with extreme image breakpoints</h3>
      <Image
        urlEndpoint="https://ik.imagekit.io/demo/"
        src="/default-image.jpg"
        alt="image breakpoints"
        responsive={true}
        imageBreakpoints={[100, 5000]}
        width={300}
        height={300}
      />
    </div>
  </div>
</body>
</html>
