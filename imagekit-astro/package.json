{
  "name": "@imagekit/astro",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Astro SDK for ImageKit.io - optimized image & video delivery with transformations",
  "types": "./dist/index.d.ts",
  "keywords": [
    "imagekit",
    "astro",
    "astro-component",
    "image",
    "video",
    "optimization",
    "transformation",
    "responsive"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.ts"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "default": "./dist/integration.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./image-service": {
      "types": "./dist/imagekit-service.d.ts",
      "default": "./dist/imagekit-service.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.ts",
    "src"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepublishOnly": "cp ../README.md . && cp ../LICENSE . && pnpm build",
    "postpublish": "rm ./README.md && rm ./LICENSE"
  },
  "dependencies": {
    "@imagekit/javascript": "^5.1.0"
  },
  "peerDependencies": {
    "astro": ">=5.14.2"
  },
  "devDependencies": {
    "astro": "^5.11.0",
    "tsup": "^8.4.0"
  }
}
