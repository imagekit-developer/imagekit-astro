{
  "name": "@imagekit/astro",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Astro SDK for ImageKit.io - optimized image & video delivery with transformations",
  "module": "./index.ts",
  "keywords": [
    "imagekit",
    "astro",
    "astro-component",
    "image",
    "video",
    "optimization",
    "transformation",
    "responsive"
  ],
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./server": {
      "import": "./src/server/index.ts"
    },
    "./image-service": {
      "import": "./src/services/imagekit-service.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "helpers",
    "src",
    "index.ts"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepublishOnly": "cp ../README.md . && cp ../LICENSE . && pnpm build",
    "postpublish": "rm ./README.md && rm ./LICENSE"
  },
  "dependencies": {
    "@imagekit/javascript": "^5.1.0"
  },
  "peerDependencies": {
    "astro": ">=3.2.0"
  },
  "devDependencies": {
    "astro": "^5.11.0",
    "tsup": "^8.4.0"
  }
}
