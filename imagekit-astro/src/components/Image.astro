---
import { Image as AstroImage, type RemoteImageProps } from 'astro:assets';
import type { ImageProps } from '../types';

// Combine Astro's RemoteImageProps with ImageKit props
type Props = RemoteImageProps & ImageProps;

const {
  class: className,
  ...props
}: Props = Astro.props;

// Build the class name
let imageClassName = 'astro-imagekit-image';
if (className) {
  imageClassName = `${imageClassName} ${className}`;
}
---

<AstroImage
  class={imageClassName}
  {...props}
/>
