---
import { buildSrc } from '@imagekit/javascript';
import { getImageKitConfig } from '../lib/imagekit.js';
import { getInt } from '../helpers/index.js';
import { OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT } from '../constants/sizes.js';
import type { IKOgImageProps } from '../types/index.js';

interface Props extends IKOgImageProps {}

const {
  src,
  alt,
  twitterTitle,
  urlEndpoint,
  transformation = [],
  queryParameters,
  transformationPosition,
  format,
  ...restProps
}: Props = Astro.props;

// Validate required props
if (!twitterTitle) {
  throw new Error('[IKOgImage] twitterTitle is required for the IKOgImage component.');
}

// Resolve config
const config = getImageKitConfig({ urlEndpoint, transformationPosition });

// Determine dimensions
const widthInt = getInt(restProps.width);
const heightInt = getInt(restProps.height);
const width: number = Number.isNaN(widthInt) ? OG_IMAGE_WIDTH : widthInt;
const height: number = Number.isNaN(heightInt) ? OG_IMAGE_HEIGHT : heightInt;

// Generate OG image URL (default format, typically jpg)
const ogImageUrl = buildSrc({
  src,
  urlEndpoint: config.urlEndpoint,
  transformation: [
    ...transformation,
    { width, height },
  ],
  queryParameters,
  transformationPosition: config.transformationPosition,
});

// Generate Twitter image URL (WebP for better compression where supported)
const twitterImageUrl = buildSrc({
  src,
  urlEndpoint: config.urlEndpoint,
  transformation: [
    ...transformation,
    { width, height, format: format || 'webp' },
  ],
  queryParameters,
  transformationPosition: config.transformationPosition,
});
---

<meta property="og:title" content={twitterTitle} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:width" content={String(width)} />
<meta property="og:image:height" content={String(height)} />
{alt && <meta property="og:image:alt" content={alt} />}
<meta property="twitter:title" content={twitterTitle} />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:image" content={twitterImageUrl} />
