---
import { buildSrc } from '@imagekit/javascript';
import {
  urlEndpoint as integrationUrlEndpoint,
  transformationPosition as integrationTransformationPosition,
} from 'virtual:@imagekit/astro/config';
import { getImageKitConfig } from '../lib/imagekit';
import type { VideoProps } from '../types/index';

interface Props extends VideoProps {}

const {
  src,
  urlEndpoint,
  transformation = [],
  queryParameters,
  transformationPosition,
  class: className,
  ...restProps
}: Props = Astro.props;

// Resolve ImageKit configuration.
// Priority: prop > integration config (astro.config.mjs) > env vars.
const config = getImageKitConfig({
  urlEndpoint: urlEndpoint ?? (integrationUrlEndpoint || undefined),
  transformationPosition:
    transformationPosition ?? integrationTransformationPosition,
});

// Build the video URL
const videoSrc = buildSrc({
  src,
  urlEndpoint: config.urlEndpoint,
  transformation: [...transformation],
  queryParameters,
  transformationPosition: config.transformationPosition,
});

// Build the class name
let videoClassName = 'astro-imagekit-video';
if (className) {
  videoClassName = `${videoClassName} ${className}`;
}
---

<video
  src={videoSrc}
  class={videoClassName}
  {...restProps}
/>
